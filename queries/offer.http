# Получить список предложений
GET http://localhost:4000/offers HTTP/1.1

###

# Получить список предложений с лимитом
GET http://localhost:4000/offers?count=5 HTTP/1.1

###

# Создать новое предложение
POST http://localhost:4000/offers HTTP/1.1
Content-Type: application/json

{
  "title": "Beautiful & luxurious studio at great location",
  "description": "A quiet cozy and picturesque that hides behind a a river by the unique lightness of Amsterdam.",
  "publicationDate": "2024-02-09T00:00:00.000Z",
  "city": "Amsterdam",
  "previewImage": "https://url-to-image/preview.jpg",
  "images": [
    "https://url-to-image/1.jpg",
    "https://url-to-image/2.jpg",
    "https://url-to-image/3.jpg",
    "https://url-to-image/4.jpg",
    "https://url-to-image/5.jpg",
    "https://url-to-image/6.jpg"
  ],
  "isPremium": false,
  "type": "apartment",
  "bedrooms": 3,
  "maxAdults": 4,
  "price": 120,
  "goods": ["Breakfast", "Air conditioning"],
  "hostId": "6329c3d6a04ab1061c6425ea",
  "location": {
    "latitude": 52.370216,
    "longitude": 4.895168,
    "zoom": 10
  }
}

###

# Получить детальную информацию о предложении
GET http://localhost:4000/offers/6329c3d6a04ab1061c6425ea HTTP/1.1

###

# Обновить предложение
PATCH http://localhost:4000/offers/6329c3d6a04ab1061c6425ea HTTP/1.1
Content-Type: application/json

{
  "title": "Updated studio title goes here",
  "price": 150
}

###

# Удалить предложение
DELETE http://localhost:4000/offers/6329c3d6a04ab1061c6425ea HTTP/1.1

###

# Премиальные предложения для города
GET http://localhost:4000/offers/premium/Amsterdam HTTP/1.1

###

# Список избранного
GET http://localhost:4000/favorites?userId=6329c3d6a04ab1061c6425ea HTTP/1.1

###

# Добавить в избранное
POST http://localhost:4000/favorites/6329c3d6a04ab1061c6425ea HTTP/1.1
Content-Type: application/json

{
  "userId": "6329c3d6a04ab1061c6425ea"
}

###

# Удалить из избранного
DELETE http://localhost:4000/favorites/6329c3d6a04ab1061c6425ea HTTP/1.1
Content-Type: application/json

{
  "userId": "6329c3d6a04ab1061c6425ea"
}
